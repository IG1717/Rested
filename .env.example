# Neon pooled connection string
DATABASE_URL=
# Google OAuth web client (Google Cloud project with the Google Health API enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of the app, no trailing slash (http://localhost:3000 in dev)
APP_URL=http://localhost:3000
# openssl rand -base64 32
SESSION_SECRET=
# openssl rand -base64 32 (AES-256-GCM key for stored Google tokens)
TOKEN_ENC_KEY=
# Shared secret Google Health sends in the Authorization header of webhook calls
WEBHOOK_SECRET=
# Vercel Cron bearer secret
CRON_SECRET=
