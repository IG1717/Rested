# Copy to .env.local and fill in. Never commit the real values.

# Postgres connection string. On Supabase, use the transaction pooler (port 6543), e.g.
# postgresql://<role>.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Google OAuth web client (Google Cloud project with the Google Health API enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of the app, no trailing slash
APP_URL=http://localhost:3000

# openssl rand -base64 32
SESSION_SECRET=
# openssl rand -base64 32 (AES-256-GCM key for stored Google tokens; rotating it disconnects everyone)
TOKEN_ENC_KEY=

# Shared secret Google Health sends in the Authorization header of webhook calls
WEBHOOK_SECRET=
# Bearer secret Vercel Cron sends to /api/cron/sync
CRON_SECRET=

# Web Push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A URL or mailto: push services can use to reach you
VAPID_SUBJECT=
